# ── Live model provider (optional) ────────────────────────────────────────────
# Leave all keys empty to run entirely on the deterministic mock model.
# Whichever key is provided (Anthropic, OpenAI, or OpenRouter) will be used.
# If multiple keys are set, you can set FLOWFORGE_PROVIDER to anthropic, openai, or openrouter.

# OpenAI (automatically uses smallest model gpt-4o-mini to consume minimal tokens)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (native SDK, exact token usage)
ANTHROPIC_API_KEY=

# OpenRouter (OpenAI-compatible gateway). Use this if you only have an
# OpenRouter key, e.g. sk-or-v1-...
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Optional attribution headers shown on the OpenRouter dashboard
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=FlowForge AI

# Optional override to force a provider when multiple keys exist: anthropic | openai | openrouter
# FLOWFORGE_PROVIDER=

# ── Application ──────────────────────────────────────────────────────────────
# Anthropic model id. Mapped automatically:
# - With OpenAI: maps to smallest model (gpt-4o-mini)
# - With OpenRouter: maps claude-opus-5-5 -> anthropic/claude-opus-5.5
FLOWFORGE_MODEL=claude-opus-5-5

# Start in live mode when a key is configured. Default (unset/0) is the deterministic mock model,
# so the demo behaves identically with or without a key. Toggle at runtime in the top bar.
# FLOWFORGE_DEFAULT_LIVE=0

# Comma-separated https hosts the HTTP Request node may call.
# EMPTY = only mock:// endpoints (recommended for the demo).
# Example: FLOWFORGE_HTTP_ALLOWLIST=api.example.com,httpbin.org
FLOWFORGE_HTTP_ALLOWLIST=

# SQLite location (optional)
# FLOWFORGE_DB=./data/flowforge.db
